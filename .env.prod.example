# Copiar a .env.prod en la raíz del repo y completar con valores reales antes
# de desplegar. NUNCA commitear el .env.prod real.

POSTGRES_USER=stock_user
POSTGRES_PASSWORD=generar_una_contrasena_fuerte_aca
POSTGRES_DB=control_de_stock

# Generar con: openssl rand -base64 48
JWT_SECRET=generar_un_secreto_largo_y_aleatorio_aca
JWT_EXPIRES_IN=8h

# Dominio real desde el que se sirve el frontend en producción.
CORS_ORIGIN=https://tu-dominio.com

# Puertos publicados en el host (opcionales, tienen default).
API_PORT=4000
WEB_PORT=80
