{
  "name": "control-de-stock",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema profesional de gestión de stock para PyMEs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @control-stock/api",
    "dev:web": "npm run dev -w @control-stock/web",
    "build": "npm run build -w @control-stock/shared && npm run build -w @control-stock/api && npm run build -w @control-stock/web",
    "build:shared": "npm run build -w @control-stock/shared",
    "build:api": "npm run build -w @control-stock/api",
    "build:web": "npm run build -w @control-stock/web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "prisma:generate": "npm run prisma:generate -w @control-stock/api",
    "prisma:migrate": "npm run prisma:migrate -w @control-stock/api",
    "prisma:studio": "npm run prisma:studio -w @control-stock/api",
    "db:seed": "npm run db:seed -w @control-stock/api",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
