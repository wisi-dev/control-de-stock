# Variables de entorno raíz — usadas por docker-compose.
# Cada app (apps/api, apps/web) tiene su propio .env.example más específico.

# --- Base de datos (Postgres, usado por docker-compose) ---
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=control_de_stock
POSTGRES_PORT=5432

# --- Adminer (UI web para inspeccionar la base de datos en desarrollo) ---
ADMINER_PORT=8080
