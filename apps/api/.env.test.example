# Copiar a .env.test. Usa una base de datos separada de la de desarrollo:
# los tests truncan tablas entre archivos, así que nunca debe apuntar a la
# base con la que estás probando la app a mano.
NODE_ENV=test
PORT=4001
DATABASE_URL="postgresql://stock_user:change_me_in_local_env@localhost:5432/control_de_stock_test?schema=public"
JWT_SECRET="test-secret-not-for-production-aaaaaaaaaaaaaaaaaaaa"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"
