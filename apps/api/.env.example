# Copiar a .env y completar con valores reales en desarrollo/producción.

NODE_ENV=development
PORT=4000

# Debe coincidir con las credenciales de docker/docker-compose.yml (o tu Postgres real)
DATABASE_URL="postgresql://stock_user:change_me_in_local_env@localhost:5432/control_de_stock?schema=public"

# Secreto para firmar JWT — generar uno propio y robusto en cada entorno
# (ej: openssl rand -base64 48)
JWT_SECRET="change_me_use_a_long_random_string"
JWT_EXPIRES_IN="8h"

# Origen(es) permitido(s) para CORS, separados por coma
CORS_ORIGIN="http://localhost:5173"
